import pandas as pd
import matplotlib.pyplot as plt

# Training dataset
data = {
    'Sky': ['Sunny', 'Sunny', 'Rainy', 'Sunny'],
    'AirTemp': ['Warm', 'Warm', 'Cold', 'Warm'],
    'Humidity': ['Normal', 'High', 'High', 'High'],
    'Wind': ['Strong', 'Strong', 'Strong', 'Strong'],
    'Water': ['Warm', 'Warm', 'Warm', 'Cool'],
    'Forecast': ['Same', 'Same', 'Change', 'Same'],
    'EnjoySport': ['Yes', 'Yes', 'No', 'Yes']
}

df = pd.DataFrame(data)

print("Training Dataset:")
print(df)

# FIND-S algorithm
attributes = list(df.columns[:-1])
hypothesis = ['0'] * len(attributes)

print("\nSteps of FIND-S Algorithm:")

for i, row in df.iterrows():
    if row['EnjoySport'] == 'Yes':
        for j, attr in enumerate(attributes):
            if hypothesis[j] == '0':
                hypothesis[j] = row[attr]
            elif hypothesis[j] != row[attr]:
                hypothesis[j] = '?'

        print(f"After positive example {i+1}: {hypothesis}")

print("\nFinal Most Specific Hypothesis:")
print(hypothesis)

# Visualization using Matplotlib
plt.figure(figsize=(10, 5))
plt.bar(attributes, [1 if x != '?' else 2 for x in hypothesis],
        color='skyblue', edgecolor='black')

plt.title("FIND-S Algorithm - Final Hypothesis")
plt.xlabel("Attributes")
plt.ylabel("Hypothesis Type")
plt.yticks([1, 2], ['Specific Value', 'Any Value (?)'])
plt.grid(axis='y', linestyle='--', alpha=0.5)
plt.show()
