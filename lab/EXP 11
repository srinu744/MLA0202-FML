# Credit Score Classification using Machine Learning

import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import accuracy_score, classification_report
from sklearn.preprocessing import LabelEncoder

# Step 1: Create Dataset
data = {
    'Income': [25000, 40000, 50000, 60000, 75000,
               30000, 85000, 90000, 45000, 70000],
    'Age': [22, 25, 30, 35, 40, 24, 45, 50, 28, 38],
    'Loan': [50000, 30000, 40000, 20000, 15000,
             45000, 10000, 12000, 35000, 18000],
    'CreditScore': ['Poor', 'Poor', 'Standard', 'Good',
                    'Good', 'Poor', 'Good', 'Good',
                    'Standard', 'Good']
}

df = pd.DataFrame(data)

# Step 2: Separate Input and Output
X = df[['Income', 'Age', 'Loan']]
y = df['CreditScore']

# Step 3: Split Dataset
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

# Step 4: Train Model
model = RandomForestClassifier(n_estimators=100, random_state=42)
model.fit(X_train, y_train)

# Step 5: Predict Credit Score
y_pred = model.predict(X_test)

# Step 6: Calculate Accuracy
accuracy = accuracy_score(y_test, y_pred)

print("Credit Score Classification")
print("---------------------------")
print("Actual Values:", list(y_test))
print("Predicted Values:", list(y_pred))
print("Accuracy:", accuracy * 100, "%")

print("\nClassification Report:")
print(classification_report(y_test, y_pred, zero_division=0))

# Step 7: Predict New Customer
new_customer = pd.DataFrame(
    [[55000, 32, 25000]],
    columns=['Income', 'Age', 'Loan']
)

prediction = model.predict(new_customer)
print("\nNew Customer Credit Score:", prediction[0])

# Step 8: Display Graph
df['CreditScore'].value_counts().plot(
    kind='bar', color=['skyblue', 'orange', 'green']
)

plt.title("Credit Score Classification")
plt.xlabel("Credit Score")
plt.ylabel("Number of Customers")
plt.show()
