import numpy as np
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.metrics import mean_squared_error, r2_score

# Step 1: Prepare the dataset
# Hours studied and marks scored
X = np.array([1, 2, 3, 4, 5, 6, 7, 8]).reshape(-1, 1)
y = np.array([35, 40, 50, 55, 65, 70, 75, 85])

# Step 2: Create the Linear Regression model
model = LinearRegression()

# Step 3: Train the model
model.fit(X, y)

# Step 4: Predict the values
y_pred = model.predict(X)

# Step 5: Display model parameters
print("Linear Regression Results")
print("Slope:", round(model.coef_[0], 2))
print("Intercept:", round(model.intercept_, 2))
print("Mean Squared Error:", round(mean_squared_error(y, y_pred), 2))
print("R-squared Score:", round(r2_score(y, y_pred), 3))

# Step 6: Predict marks for 9 hours of study
hours = np.array([[9]])
predicted_marks = model.predict(hours)
print("Predicted marks for 9 hours of study:",
      round(predicted_marks[0], 2))

# Step 7: Visualize the results
plt.scatter(X, y, color="blue", label="Actual Marks")
plt.plot(X, y_pred, color="red", label="Regression Line")
plt.xlabel("Hours Studied")
plt.ylabel("Marks Scored")
plt.title("Linear Regression: Hours vs Marks")
plt.legend()
plt.grid(True)
plt.show()
