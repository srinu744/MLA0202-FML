import numpy as np
import matplotlib.pyplot as plt
from sklearn.mixture import GaussianMixture

# Generate sample data
np.random.seed(42)

X1 = np.random.normal(2, 0.5, (100, 2))
X2 = np.random.normal(6, 0.7, (100, 2))
X = np.vstack((X1, X2))

# Apply Expectation-Maximization using Gaussian Mixture Model
model = GaussianMixture(n_components=2, random_state=42)
model.fit(X)

# Predict clusters
labels = model.predict(X)

# Display results
print("Cluster Means:")
print(model.means_)

print("\nNumber of clusters:", model.n_components)
print("Converged:", model.converged_)
print("Number of iterations:", model.n_iter_)

# Plot clusters
plt.scatter(X[:, 0], X[:, 1], c=labels, cmap='viridis')
plt.scatter(model.means_[:, 0], model.means_[:, 1],
            color='red', marker='X', s=200,
            label='Cluster Centers')

plt.title("Expectation-Maximization Algorithm")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.legend()
plt.grid(True)
plt.show()
